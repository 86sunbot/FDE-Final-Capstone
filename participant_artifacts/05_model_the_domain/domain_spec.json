    {"name": "ManufacturingStarted", "authority_required": false},
    {"name": "ManufacturingCompleted", "authority_required": false},
    {"name": "ReleaseReviewStarted", "authority_required": true},
    {"name": "ReleaseHeld", "authority_required": true},
    {"name": "HoldResolved", "authority_required": true},
    {"name": "ProductReceiptVerified", "authority_required": true},
