{
  "metadata": {
    "name": "CGT Patient-to-Batch Canonical Domain Specification",
    "version": "0.1.0-draft",
    "status": "DRAFT_PENDING_DOMAIN_OWNER_APPROVAL",
    "source_baseline_sha256": "74d31dc4694d52b0e9a9fb337e6ccda1086ad430b19287f9ca2b4b4e650ca979"
  },
  "assessment_outcomes": [
    "SATISFIED",
    "NOT_SATISFIED",
    "UNKNOWN",
    "NOT_APPLICABLE"
  ],
  "identifier_types": [
    "JourneyId",
    "SourceRecordId",
    "PatientKey",
    "MRNAssertion",
    "ClinicalSubjectId",
    "CollectionId",
    "BagId",
    "COIId",
    "ShipmentId",
    "SlotId",
    "BatchId",
    "DeviationId",
    "EventId",
    "CommandId"
  ],
  "rules": [
    {
      "id": "BR-EVD-001",
      "severity": "P0",
      "owner": "DataOwner",
      "statement": "Preserve raw value, source record, occurred or effective time, and recorded time for each decision-relevant assertion."
    },
    {
      "id": "BR-EVD-002",
      "severity": "P0",
      "owner": "JourneyOwner",
      "statement": "Every canonical transition cites evidence and rule or policy versions."
    },
    {
      "id": "BR-ID-001",
      "severity": "P0",
      "owner": "IdentityAuthority",
      "statement": "No identity or lineage relation is created solely from one ambiguous identifier or model score."
    },
    {
      "id": "BR-ID-002",
      "severity": "P0",
      "owner": "IdentityAuthority",
      "statement": "MRNs are namespace-qualified assertions and are not assumed globally unique."
    },
    {
      "id": "BR-STATE-001",
      "severity": "P0",
      "owner": "DomainOwner",
      "statement": "Only a legal transition with satisfied guards changes canonical state."
    },
    {
      "id": "BR-TIME-001",
      "severity": "P0",
      "owner": "DataOwner",
      "statement": "Occurred and recorded time remain distinct."
    },
    {
      "id": "BR-CMD-001",
      "severity": "P0",
      "owner": "ServiceOwner",
      "statement": "An idempotency key binds one canonical payload and command type and scope."
    },
    {
      "id": "BR-CMD-002",
      "severity": "P0",
      "owner": "ServiceOwner",
      "statement": "An unknown external outcome is reconciled before retry or compensation."
    },
    {
      "id": "BR-AUTH-001",
      "severity": "P0",
      "owner": "SecurityAndBusinessAuthority",
      "statement": "Authority derives from authenticated identity and server-side policy."
    },
    {
      "id": "BR-AUTH-002",
      "severity": "P0",
      "owner": "BusinessAuthority",
      "statement": "Recommendation, approval, and execution are separate events."
    },
    {
      "id": "BR-AI-001",
      "severity": "P0",
      "owner": "QualityClinicalAndSecurity",
      "statement": "AI output never establishes identity, lineage, disposition, release, or clinical readiness."
    }
  ],
  "event_envelope": {
    "required_fields": [
      "event_id",
      "event_type",
      "schema_version",
      "aggregate_type",
      "aggregate_id",
      "sequence",
      "occurred_at",
      "recorded_at",
      "source_system",
      "evidence_refs",
      "correlation_id",
      "actor",
      "data_quality",
      "payload",
      "payload_digest",
      "classification",
      "trace_id"
    ],
    "conditional_fields": [
      "effective_from",
      "effective_to",
      "source_record_id",
      "causation_id",
      "authority",
      "policy_versions",
      "confidence",
      "supersedes_event_id"
    ]
  },
  "event_types": [
    {"name": "IdentityConflictDetected", "authority_required": false},
    {"name": "IdentityResolutionProposed", "authority_required": false},
    {"name": "IdentityResolutionApproved", "authority_required": true},
    {"name": "IdentityResolutionRejected", "authority_required": true},
    {"name": "IdentityResolutionApplied", "authority_required": true},
    {"name": "ProductReleased", "authority_required": true},
    {"name": "ProductReleaseRejected", "authority_required": true},
    {"name": "ReleaseDecisionSuperseded", "authority_required": true},
    {"name": "RecommendationGenerated", "authority_required": false},
    {"name": "ApprovalRecorded", "authority_required": true},
    {"name": "AuthorizationDenied", "authority_required": false},
    {"name": "IdempotencyConflictDetected", "authority_required": false},
    {"name": "CommandAccepted", "authority_required": false},
    {"name": "CommandDispatched", "authority_required": false},
    {"name": "CommandSucceeded", "authority_required": false},
    {"name": "CommandFailed", "authority_required": false},
    {"name": "CommandOutcomeUnknown", "authority_required": false},
    {"name": "CommandReconciled", "authority_required": false},
    {"name": "ExceptionAssigned", "authority_required": false},
    {"name": "ExceptionEscalated", "authority_required": false},
    {"name": "ExceptionResolutionProposed", "authority_required": false},
