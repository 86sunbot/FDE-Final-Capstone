{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fde-capstone:command:v1",
  "title": "Command",
  "type": "object",
  "additionalProperties": false,
  "required": ["command_id", "idempotency_key", "command_type", "scope", "payload", "payload_digest", "actor", "correlation_id"],
  "properties": {
    "command_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "command_type": {"enum": ["ReserveSlot", "ReconcileReservation", "CompensateReservation"]},
    "scope": {"type": "string", "minLength": 1},
    "payload": {"type": "object"},
    "payload_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "actor": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1}
  }
}
