FDE_DB=runtime/control-tower.db
AI_MODE=off

# Optional: required only for mutating demo APIs such as POST /slots/reservations.
# Generate long random tokens; do not commit real tokens. Roles/scopes are fixed
# server-side and are not accepted from caller-supplied identity headers.
FDE_DEMO_IDENTITIES_JSON={"replace-with-random-planner-token":{"subject":"demo-planner","roles":["PLANNER"],"scopes":["*"]}}
